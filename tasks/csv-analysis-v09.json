{
  "id": "csv-analysis-v09",
  "chain": "csv",
  "title": "CSV 分析（v09）",
  "workspace": {
    "root": "var/workspaces/csv-v09",
    "read": [
      "data"
    ],
    "write": [
      "out"
    ]
  },
  "inputs": [
    "data/tickets.csv"
  ],
  "prompt": "分析 data/tickets.csv。客服工单，性能类工单后期响应时长异常。目标：找出异常时间段与类别。输出 out/analysis.md（结论与可复算的数值）、out/chart.svg（带标题/单位/坐标轴标签）、out/clean.csv（清洗后的数据）。不要联网。 图表一次写完即可，不要反复改写同一份 SVG；产物写完后立即结束。",
  "network": "deny",
  "expectedArtifacts": [
    "out/analysis.md",
    "out/chart.svg",
    "out/clean.csv"
  ],
  "acceptance": [
    "行数、总订单、退款率可复算",
    "缺失/非法行在 analysis.md 中报告",
    "图表有标题、单位、月份和地区标签",
    "结论引用具体数值",
    "run.json.tools 不含 websearch / webfetch"
  ],
  "limits": {
    "maxMinutes": 20,
    "maxCostUsd": 0.8
  },
  "checkpoint": {
    "enabled": true,
    "keep": 30
  },
  "artifactRules": {
    "out/analysis.md": {
      "minChars": 300,
      "maxChars": 8000
    },
    "out/chart.svg": {
      "requireSvg": true
    }
  }
}
