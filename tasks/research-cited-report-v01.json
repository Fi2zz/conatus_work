{
  "id": "research-cited-report-v01",
  "chain": "research",
  "title": "调研 macOS 本地优先 AI 工作台的三个前置问题",
  "workspace": {
    "root": "var/workspaces/research-v01",
    "read": [
      "inbox"
    ],
    "write": [
      "out"
    ]
  },
  "inputs": [
    "inbox/brief.md"
  ],
  "prompt": "阅读 inbox/brief.md，围绕其中的 3 个问题做调研；至少 6 个来源，其中 3 个一手来源；输出 1500-2500 字中文报告，每个事实性结论必须有脚注；不确定的内容标记为推断。不得编造 URL 或引文。",
  "network": "allow",
  "expectedArtifacts": [
    "out/report.md",
    "out/sources.json"
  ],
  "acceptance": [
    "每个事实性结论有引用或标注推断",
    "sources.json 至少 6 条，含 url/title/kind/accessedAt/fetchedAt/httpStatus/quote",
    "只收录抓取成功的 URL",
    "没有写入 out/ 之外"
  ],
  "limits": {
    "maxMinutes": 20,
    "maxCostUsd": 1.5
  },
  "checkpoint": {
    "enabled": true,
    "keep": 30
  },
  "artifactRules": {
    "out/report.md": {
      "minChars": 1500,
      "maxChars": 20000,
      "contains": [
        "结论"
      ]
    },
    "out/sources.json": {
      "check": "sources-json"
    }
  }
}
